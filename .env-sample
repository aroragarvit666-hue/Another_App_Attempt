# Copy to .env and fill in real values before running aio app run / aio app deploy

# Adobe I/O Runtime credentials (set automatically by `aio app use`)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

# Log level for actions (info | debug)
LOG_LEVEL=debug

# The Files SDK provisions storage automatically from your Runtime namespace —
# no extra secrets are required for this app.
